# Copy to .env and fill in real values. Never commit real keys.

# Server
PORT=3000
LOG_LEVEL=info

# Observability (off by default)
SENTRY_DSN=

# CORS for public /api routes. Empty means allow any origin.
CORS_ORIGIN=

# Rate limiting for /api routes: per-IP in-memory fixed window.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Passwordless auth (Better Auth, email OTP). AUTH_SECRET is required in
# production; dev falls back to an ephemeral secret. SMTP is shared with
# the contact form — without it codes are logged to the server console.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_EMAIL_FROM=auth@localhost
AUTH_DB_PATH=data/auth.db
AUTH_TRUSTED_ORIGINS=

# AI features (off by default: no key means the seam stays disabled).
# Any OpenAI-compatible endpoint works; the default is Ollama Cloud.
AI_API_KEY=
AI_BASE_URL=https://ollama.com/v1
AI_MODEL=gpt-oss:120b
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1024
# Refuse a call whose estimated cost is above this. 0.25 means 25 cents.
AI_MAX_COST_USD_PER_REQUEST=0.25
AI_TEMPERATURE=0.2
